# PostgreSQL connection string used by the backend.
DATABASE_URL=postgresql+psycopg://quickdesk:quickdesk@localhost:5432/quickdesk
# JWT signing secret. Generate one with: openssl rand -hex 32
JWT_SECRET_KEY=
# JWT signing algorithm.
JWT_ALGORITHM=HS256
# JWT lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Runtime mode. Use dev only for a generated local-only JWT secret.
QUICKDESK_ENV=dev
# Phase 2 - NVIDIA NIM (OpenAI-compatible), key from build.nvidia.com.
NVIDIA_API_KEY=
# Phase 2 - NVIDIA NIM base URL.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Phase 2 - NVIDIA NIM model.
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
